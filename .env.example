# ==================================================
# Docker Compose do ClinicAI - ambiente local
# ==================================================
# Copie este arquivo para .env antes de executar o Docker Compose.

COMPOSE_PROJECT_NAME=clinicai

# Banco de dados local. A credencial abaixo é padronizada para facilitar a
# reprodução acadêmica e não deve ser reutilizada em uma hospedagem pública.
POSTGRES_DB=clinicai
POSTGRES_USER=clinicai
POSTGRES_PASSWORD=clinicai123

# Portas publicadas somente em 127.0.0.1 pelo Compose de desenvolvimento.
POSTGRES_PORT=5432
BACKEND_PORT=8000
AI_PORT=8001
FRONTEND_PORT=3000

# GitHub Release que contém os artefatos de IA.
# O repositório precisa estar público para download sem autenticação.
MODEL_RELEASE_REPOSITORY=clice/tcc-project-clinicai
MODEL_RELEASE_TAG=models-v0.1.0
MODEL_RELEASE_MANIFEST=manifesto_modelos.json
