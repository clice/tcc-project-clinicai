# ==================================================
# Frontend do ClinicAI - .env.example
# ==================================================

# Ambiente
VITE_APP_NAME=ClinicAI
VITE_ENV=development
VITE_DEBUG=true

# ==================================================
# Servidor Frontend (Vite)
# ==================================================

VITE_HOST=0.0.0.0
VITE_PORT=3000

# ==================================================
# API Backend
# URL usada pelo frontend para acessar o FastAPI
# ==================================================

VITE_API_URL=http://localhost:8000

# ==================================================
# Autenticação
# ==================================================

VITE_TOKEN_STORAGE_KEY=clinicai_token
VITE_REFRESH_STORAGE_KEY=clinicai_refresh_token
VITE_USER_STORAGE_KEY=clinicai_current_user

# ==================================================
# Interface
# ==================================================

VITE_DEFAULT_THEME=light
VITE_DEFAULT_LANGUAGE=pt-BR
