# ==================================================
# Backend do ClinicAI - .env.example
# ==================================================

# Aplicação
PROJECT_NAME=ClinicAI

# ==================================================
# Banco de Dados PostgreSQL
# Dentro do Docker use: db
# Fora do Docker use: localhost
# ==================================================

# No Docker Compose, esta URL é sobrescrita com os valores do .env da raiz.
# Para execução local sem Docker, esta URL usa a credencial acadêmica padrão.
DATABASE_URL=postgresql+psycopg://clinicai:clinicai123@localhost:5432/clinicai

# ==================================================
# Segurança / JWT
# ==================================================

# Chave exclusiva do ambiente acadêmico local. Troque apenas se o sistema for
# exposto fora da máquina de desenvolvimento.
SECRET_KEY=clinicai-local-development-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==================================================
# CORS
# URLs permitidas para acessar o backend
# ==================================================

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==================================================
# SERVIÇO DE IA
# Dentro do Docker use: http://ai:8001
# Fora do Docker use: http://localhost:8001
# ==================================================

AI_SERVICE_URL=http://ai:8001
AI_SERVICE_TIMEOUT_SECONDS=120

# ==================================================
# UPLOADS
# ==================================================

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
