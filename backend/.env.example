# ==================================================
# Backend do ClinicAI - .env.example
# ==================================================

# Ambiente
PROJECT_NAME=ClinicAI
ENV=development
DEBUG=true

# ==================================================
# Servidor
# ==================================================

HOST=0.0.0.0
PORT=8000

# ==================================================
# Dados iniciais
# ==================================================

# bootstrap: somente catálogos estruturais, sem usuários/pacientes/exames.
# academic_demo: acrescenta exclusivamente dados fictícios e as credenciais
# acadêmicas documentadas no README. Nunca use academic_demo com dados reais.
SEED_MODE=academic_demo

# ==================================================
# Banco de Dados PostgreSQL
# Dentro do Docker use: db
# Fora do Docker use: localhost
# ==================================================

POSTGRES_DB=clinicai
POSTGRES_USER=clinicai
POSTGRES_PASSWORD=clinicai123
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://clinicai:clinicai123@db:5432/clinicai

# ==================================================
# Segurança / JWT
# ==================================================

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==================================================
# CORS
# URLs permitidas para acessar o backend
# ==================================================

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==================================================
# UPLOADS
# ==================================================

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Limites defensivos para imagens de exames.
MAX_IMAGE_WIDTH_PX=12000
MAX_IMAGE_HEIGHT_PX=12000
MAX_IMAGE_PIXELS=40000000
