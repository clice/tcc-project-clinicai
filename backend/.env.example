# ==================================================
# Backend do ClinicAI - .env.example
# ==================================================

# Ambiente
PROJECT_NAME=ClinicAI
ENV=development
DEBUG=true

# ==================================================
# Servidor
# ==================================================

HOST=0.0.0.0
PORT=8000

# ==================================================
# Dados iniciais
# ==================================================

# bootstrap: catálogos estruturais + um Administrador Master inicial.
# academic_demo: executa o bootstrap e acrescenta dados acadêmicos de demonstração.
# Os registros clínicos são fictícios; as imagens Kvasir são licenciadas e documentadas.
# Nunca use academic_demo com dados reais.
SEED_MODE=bootstrap

# Credenciais iniciais do modo bootstrap.
# Altere estes valores fora do ambiente acadêmico local.
BOOTSTRAP_ADMIN_NAME="Administrador Master"
BOOTSTRAP_ADMIN_EMAIL=admin@clinicai.com
BOOTSTRAP_ADMIN_CPF=39053344705
BOOTSTRAP_ADMIN_PASSWORD=clinicai123

# ==================================================
# Banco de Dados PostgreSQL
# Dentro do Docker use: db
# Fora do Docker use: localhost
# ==================================================

POSTGRES_DB=clinicai
POSTGRES_USER=clinicai
POSTGRES_PASSWORD=clinicai123
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://clinicai:clinicai123@db:5432/clinicai

# ==================================================
# Segurança / JWT
# ==================================================

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==================================================
# CORS
# URLs permitidas para acessar o backend
# ==================================================

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==================================================
# UPLOADS
# ==================================================

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Limites defensivos para imagens de exames.
MAX_IMAGE_WIDTH_PX=12000
MAX_IMAGE_HEIGHT_PX=12000
MAX_IMAGE_PIXELS=40000000

# Volume compartilhado: gravado pela IA e lido pelo backend.
AI_STORAGE_DIR=/app/storage
